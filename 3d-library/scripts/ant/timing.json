{
 "duration": 46.02,
 "voice_end": 44.92,
 "scenes": [
  {
   "i": 1,
   "text": "You've shrunk to the size of an ant.",
   "ws": 0.0,
   "we": 2.06,
   "start": 0.0,
   "end": 2.48
  },
  {
   "i": 2,
   "text": "One drop of coffee is nearly a hundred times heavier than you.",
   "ws": 2.6,
   "we": 6.2,
   "start": 2.48,
   "end": 6.48
  },
  {
   "i": 3,
   "text": "So you jump off the table.",
   "ws": 6.6,
   "we": 8.26,
   "start": 6.48,
   "end": 8.56
  },
  {
   "i": 4,
   "text": "To you, that's a fall from a hundred-storey building.",
   "ws": 8.68,
   "we": 11.6,
   "start": 8.56,
   "end": 11.92
  },
  {
   "i": 5,
   "text": "You just walk away.",
   "ws": 12.04,
   "we": 13.8,
   "start": 11.92,
   "end": 14.28
  },
  {
   "i": 6,
   "text": "Then it starts to rain.",
   "ws": 14.4,
   "we": 15.88,
   "start": 14.28,
   "end": 16.03
  },
  {
   "i": 7,
   "text": "Every drop knocks you flat... and water is sticky now. It won't let go.",
   "ws": 15.88,
   "we": 21.52,
   "start": 16.03,
   "end": 21.96
  },
  {
   "i": 8,
   "text": "You look up, and everything is blurry.",
   "ws": 22.08,
   "we": 24.28,
   "start": 21.96,
   "end": 24.68
  },
  {
   "i": 9,
   "text": "Your pupils are thinner than a hair. Light can't focus.",
   "ws": 24.8,
   "we": 28.26,
   "start": 24.68,
   "end": 28.68
  },
  {
   "i": 10,
   "text": "You shout for help. Nobody hears you.",
   "ws": 28.8,
   "we": 32.34,
   "start": 28.68,
   "end": 32.66
  },
  {
   "i": 11,
   "text": "Your voice is too high for human ears.",
   "ws": 32.78,
   "we": 34.88,
   "start": 32.66,
   "end": 35.22
  },
  {
   "i": 12,
   "text": "And you're getting cold. Fast.",
   "ws": 35.34,
   "we": 37.34,
   "start": 35.22,
   "end": 37.82
  },
  {
   "i": 13,
   "text": "Nothing warm-blooded is this small, and now you know why.",
   "ws": 37.94,
   "we": 41.46,
   "start": 37.82,
   "end": 41.76
  },
  {
   "i": 14,
   "text": "So you climb back to your coffee... and look up.",
   "ws": 41.88,
   "we": 44.92,
   "start": 41.76,
   "end": 46.02
  }
 ],
